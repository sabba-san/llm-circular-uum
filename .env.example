# ==============================================================================
# UUM Circular & Project Document Intelligence System — Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your preferred Database and AI API keys below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# Option A: Cloud PostgreSQL (Recommended)
# Create a free database at https://neon.tech or https://supabase.com
# Example: postgresql://username:password@ep-cool-sample.neon.tech/uum_circulars?sslmode=require
#
# Option B: Local SQLite (Leave blank to use local SQLite database at data/uum_knowledge.db)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. PRIMARY AI API: Google Gemini API
# ------------------------------------------------------------------------------
# - Used for: Text embeddings (text-embedding-004) and RAG generation (gemini-1.5-flash)
# - Cost: 100% Free tier (1,500 requests/day, no credit card required)
# - Longevity: Keys NEVER expire unless deleted
# - Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. OPTIONAL FALLBACK 1: Groq Cloud API
# ------------------------------------------------------------------------------
# - Used for: High-speed LLM fallback (llama-3.3-70b-versatile at 500+ tok/s)
# - Cost: 100% Free tier (no credit card required)
# - Longevity: Keys NEVER expire unless deleted
# - Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPTIONAL FALLBACK 2: OpenRouter API
# ------------------------------------------------------------------------------
# - Used for: Multi-model aggregator fallback
# - Get free key at: https://openrouter.ai
OPENROUTER_API_KEY=
