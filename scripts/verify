#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

PYTHON="./venv/bin/python3"
if [ ! -x "$PYTHON" ]; then
    PYTHON="python3"
fi

exec "$PYTHON" -u - "$@" <<'PY'
import argparse
import os
import shutil
import subprocess
import sys
import time

ROOT_DIR = os.getcwd()
if ROOT_DIR not in sys.path:
    sys.path.insert(0, ROOT_DIR)


def find_node():
    node = shutil.which("node")
    if node:
        return node
    nvm_node = "/home/abbas/.nvm/versions/node/v26.1.0/bin/node"
    return nvm_node if os.path.isfile(nvm_node) and os.access(nvm_node, os.X_OK) else None


def run_step(name, fn, verbose=False):
    t0 = time.time()
    ok, detail, output = fn()
    elapsed = time.time() - t0
    status = "PASS" if ok else "FAIL"
    suffix = f" — {detail}" if detail else ""
    print(f"[{status}] {name:<12} ({elapsed:.1f}s){suffix}")
    if (not ok or verbose) and output:
        lines = [line for line in output.strip().splitlines() if line.strip()]
        cap = len(lines) if verbose else 25
        for line in lines[:cap]:
            print(f"  {line}")
        if len(lines) > cap:
            print(f"  ... ({len(lines) - cap} more lines, re-run with --verbose)")
    return ok, elapsed


def step_lint():
    ruff = os.path.join(ROOT_DIR, "venv", "bin", "ruff")
    if not os.path.isfile(ruff):
        ruff = shutil.which("ruff") or ""
    if not ruff:
        return False, "ruff not installed", "Run: ./venv/bin/pip install -r requirements-dev.txt"
    proc = subprocess.run(
        [ruff, "check", "web_app.py", "pipeline.py", "ingest.py", "ask.py", "src/", "tests/", "eval/", "scripts/"],
        capture_output=True,
        text=True,
        timeout=30,
    )
    out = (proc.stdout + "\n" + proc.stderr).strip()
    return proc.returncode == 0, "ruff clean" if proc.returncode == 0 else "lint errors", out


def step_types():
    mypy = os.path.join(ROOT_DIR, "venv", "bin", "mypy")
    if not os.path.isfile(mypy):
        mypy = shutil.which("mypy") or ""
    if not mypy:
        return False, "mypy not installed", "Run: ./venv/bin/pip install -r requirements-dev.txt"
    proc = subprocess.run(
        [mypy, "web_app.py", "src/db.py", "src/search.py"],
        capture_output=True,
        text=True,
        timeout=45,
    )
    out = (proc.stdout + "\n" + proc.stderr).strip()
    summary = out.splitlines()[-1] if out else ""
    return proc.returncode == 0, summary if proc.returncode == 0 else "type errors", out


def step_boundaries():
    proc = subprocess.run(
        [sys.executable, "scripts/check_boundaries.py"],
        capture_output=True,
        text=True,
        timeout=20,
    )
    out = (proc.stdout + "\n" + proc.stderr).strip()
    summary = out.splitlines()[-1] if out else ""
    return proc.returncode == 0, summary if proc.returncode == 0 else "boundary violations", out


def step_pytest():
    proc = subprocess.run(
        [sys.executable, "-m", "pytest", "-q", "--tb=short", "tests/"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    out = (proc.stdout + "\n" + proc.stderr).strip()
    summary = out.splitlines()[-1] if out else ""
    return proc.returncode == 0, summary, out


def step_smoke():
    try:
        import logging
        for lg in ("httpx", "httpx2", "httpcore", "httpcore2"):
            logging.getLogger(lg).setLevel(logging.WARNING)
        from starlette.testclient import TestClient
        import web_app

        ast = web_app.get_assistant()
        orig_keys = (ast.ai.gemini_key, ast.ai.groq_key, ast.ai.openrouter_key)
        try:
            ast.ai.gemini_key = ""
            ast.ai.groq_key = ""
            ast.ai.openrouter_key = ""
            client = TestClient(web_app.app)

            r_health = client.get("/health")
            if r_health.status_code != 200 or r_health.json().get("chunks", 0) <= 0:
                return False, f"health={r_health.status_code}", r_health.text

            r_on = client.post("/api/ask", json={"query": "RMC 008", "scope": "RMC"})
            on_data = r_on.json()
            on_sources = len(on_data.get("sources", []))
            on_fups = len(on_data.get("follow_up_questions", []))
            if r_on.status_code != 200 or on_sources == 0 or on_fups == 0:
                return False, f"on_topic sources={on_sources} follow_ups={on_fups}", r_on.text

            r_off = client.post("/api/ask", json={"query": "what is 2+2", "scope": "RMC"})
            off_sources = len(r_off.json().get("sources", []))
            if r_off.status_code != 200 or off_sources != 0:
                return False, f"off_topic sources={off_sources} (expected 0)", r_off.text

            return True, f"health=200, on_topic={on_sources}, off_topic={off_sources}", ""
        finally:
            ast.ai.gemini_key, ast.ai.groq_key, ast.ai.openrouter_key = orig_keys
    except Exception as exc:
        return False, "exception", str(exc)


def step_eval():
    proc = subprocess.run(
        [sys.executable, "eval/run_ir_eval.py"],
        capture_output=True,
        text=True,
        timeout=300,
    )
    out = (proc.stdout + "\n" + proc.stderr).strip()
    mrr_line = next((l.strip() for l in out.splitlines() if l.strip().startswith("ALL ")), "eval complete")
    return proc.returncode == 0, mrr_line, out


def _is_port_healthy(url):
    import urllib.request
    try:
        with urllib.request.urlopen(f"{url}/health", timeout=2) as resp:
            return resp.status == 200
    except Exception:
        return False


def step_ui_fuzz(time_limit="25s", force_offline=True, target_url="http://127.0.0.1:8000"):
    bombadil_bin = os.path.join(ROOT_DIR, "node_modules", ".bin", "bombadil")
    spec_path = os.path.join(ROOT_DIR, "tests", "bombadil", "llm_uum.spec.ts")
    out_dir = os.path.join(ROOT_DIR, "bombadil-out", "latest")

    if not os.path.isfile(bombadil_bin):
        return False, "bombadil not installed", "Run: npm install --save-dev @antithesishq/bombadil"
    if not os.path.isfile(spec_path):
        return False, "spec missing", f"Expected {spec_path}"

    env = os.environ.copy()
    extra_paths = ["/home/abbas/.local/bin"]
    node_bin = find_node()
    if node_bin:
        extra_paths.append(os.path.dirname(node_bin))
    env["PATH"] = ":".join(extra_paths + [env.get("PATH", "")])

    server_proc = None
    active_url = target_url
    try:
        port_8000_up = _is_port_healthy(target_url)
        if force_offline or not port_8000_up:
            port = 18000 if port_8000_up else 8000
            active_url = f"http://127.0.0.1:{port}"
            srv_env = env.copy()
            srv_env["GEMINI_API_KEY"] = ""
            srv_env["GROQ_API_KEY"] = ""
            srv_env["OPENROUTER_API_KEY"] = ""
            server_proc = subprocess.Popen(
                [sys.executable, "-m", "uvicorn", "web_app:app", "--host", "127.0.0.1", "--port", str(port)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=srv_env,
            )
            ready = False
            for _ in range(30):
                if _is_port_healthy(active_url):
                    ready = True
                    break
                time.sleep(0.25)
            if not ready:
                return False, f"offline server failed to start on {active_url}", ""

        os.makedirs(os.path.dirname(out_dir), exist_ok=True)
        proc = subprocess.run(
            [
                bombadil_bin,
                "browser",
                "test",
                "--headless",
                "--no-sandbox",
                "--exit-on-violation",
                "--width",
                "1440",
                "--height",
                "900",
                "--time-limit",
                time_limit,
                "--output-path",
                out_dir,
                "--output-path-overwrite",
                active_url,
                spec_path,
            ],
            capture_output=True,
            text=True,
            env=env,
            timeout=300,
        )
        out = (proc.stdout + "\n" + proc.stderr).strip()

        trace_file = os.path.join(out_dir, "trace.jsonl")
        steps_count = 0
        violations = []
        if os.path.isfile(trace_file):
            import json
            with open(trace_file, "r", encoding="utf-8") as tf:
                for line in tf:
                    line = line.strip()
                    if not line:
                        continue
                    steps_count += 1
                    try:
                        entry = json.loads(line)
                        for v in entry.get("violations", []):
                            prop_name = v.get("property", "unknown")
                            if prop_name not in violations:
                                violations.append(prop_name)
                    except ValueError:
                        continue

        mode_tag = "offline-tier4" if server_proc is not None else "live"
        if proc.returncode == 0 and not violations:
            return True, f"{steps_count} states, 0 violations ({mode_tag} @ {active_url})", out
        viol_str = ", ".join(violations) if violations else f"exit={proc.returncode}"
        return False, f"violation: {viol_str} (trace: {trace_file})", out
    finally:
        if server_proc is not None:
            server_proc.terminate()
            try:
                server_proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                server_proc.kill()


def main():
    parser = argparse.ArgumentParser(description="Compact verification CLI for llm_uum")
    parser.add_argument("--eval", action="store_true", help="Also run the 36-query IR evaluation benchmark")
    parser.add_argument("--ui-fuzz", action="store_true", help="Run Bombadil property-based UI fuzzing (offline Tier-4 by default)")
    parser.add_argument("--ui-fuzz-offline", action="store_true", help="Explicitly run Bombadil against an offline Tier-4 Uvicorn instance")
    parser.add_argument("--ui-fuzz-live", action="store_true", help="Run Bombadil directly against running http://127.0.0.1:8000 instance")
    parser.add_argument("--ui-fuzz-time", default="25s", help="Duration for Bombadil UI fuzzing (default: 25s)")
    parser.add_argument("--verbose", action="store_true", help="Show full command output")
    args = parser.parse_args()

    steps = [
        ("lint", step_lint),
        ("types", step_types),
        ("boundaries", step_boundaries),
        ("pytest", step_pytest),
        ("smoke", step_smoke),
    ]
    if args.eval:
        steps.append(("ir-eval", step_eval))
    if args.ui_fuzz or args.ui_fuzz_offline or args.ui_fuzz_live:
        force_offline = not args.ui_fuzz_live
        steps.append(("ui-fuzz", lambda: step_ui_fuzz(time_limit=args.ui_fuzz_time, force_offline=force_offline)))

    t_start = time.time()
    passed = 0
    for name, fn in steps:
        ok, _ = run_step(name, fn, verbose=args.verbose)
        if not ok:
            print(f"FAIL: stopped at '{name}' ({passed}/{len(steps)} passed)")
            sys.exit(1)
        passed += 1

    total_time = time.time() - t_start
    print(f"OK: {passed}/{len(steps)} checks passed ({total_time:.1f}s)")


if __name__ == "__main__":
    main()
PY
